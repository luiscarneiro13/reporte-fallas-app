{
  "expo": {
    "name": "Casmar",
    "slug": "casmar",
    "version": "1.0.6",
    "orientation": "default",
    "icon": "./assets/icon-ios.png",
    "userInterfaceStyle": "light",
    "scheme": "casmar",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.servicioscasmar.app",
      "buildNumber": "4",
      "icon": "./assets/icon-ios.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.casmar.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 27
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/smallicon.png",
          "color": "#1E50A0"
        }
      ],
      "./plugins/withGradleJvmArgs.js",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0a5cbfd7-d2f7-47c3-9559-bce8aa0d6121"
      }
    },
    "owner": "vemitienda",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0a5cbfd7-d2f7-47c3-9559-bce8aa0d6121"
    }
  }
}
